{
  "name": "seeksense-website",
  "version": "0.1.0",
  "private": true,
  "description": "SeekSense website: statically generated pages plus a minimal enquiry server.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node src/build.ts",
    "build:production": "SITE_ENV=production node src/build.ts",
    "dev": "node --watch-path=src --watch-path=public src/dev.ts",
    "start": "node server/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,css}\" \"server/**/*.ts\" \"tests/**/*.ts\" \"public/js/**/*.js\"",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"server/**/*.ts\" \"tests/**/*.ts\" \"public/js/**/*.js\"",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node tests/browser/run.ts",
    "launch-check": "node scripts/launch-check.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "eslint": "10.1.0",
    "js-yaml": "3.15.1",
    "marked": "18.0.10",
    "playwright": "1.56.1",
    "prettier": "3.8.1",
    "typescript": "6.0.3"
  }
}
