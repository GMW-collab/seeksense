# Copy to .env (never commit .env). All values are optional unless noted.

# Build
SITE_ENV=preview                 # preview | production. Production refuses to build while any fact is unverified.
SITE_URL=https://seeksense.co    # canonical origin used for links, sitemap and Open Graph
PUBLISH_FUTURE_SECTION=false     # keep false until legal, regulatory and clinical sign-off (see docs/REGULATORY-NOTES.md)
BOOKING_URL=                     # https link to an approved scheduling provider; empty = enquiry form only

# Enquiry server (server/server.ts)
PORT=8080
ENQUIRY_TO=                      # inbox that receives enquiries (required to accept enquiries)
ENQUIRY_FROM=                    # verified sender address at the mail provider
MAIL_PROVIDER=                   # "postmark" or empty. Empty = enquiries disabled, visitors see the email fallback.
POSTMARK_SERVER_TOKEN=           # secret; set in the host's secret manager, never in the repo
TRUST_PROXY=false                # true only behind a proxy you control that sets X-Forwarded-For
